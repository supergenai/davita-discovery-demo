# Davita Agent Factory - configuration. Copy to .env and fill in.
# This is the ONE place environment differs. To move to the enterprise project
# later, change GOOGLE_CLOUD_PROJECT (and region) here - no code edits anywhere.

# --- GCP target (leave PROJECT blank to run fully offline on seed data) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1

# --- Run mode ---
# Force stub/seed mode even when a project is set (safe until datasets exist / before deploy).
# Remove or set to 0 to run against BigQuery; deploy requires this unset.
FACTORY_OFFLINE=1

# --- Optional ---
FACTORY_DATASET_PREFIX=          # prefix BigQuery datasets (multi-tenant), e.g. "dev_"
AGENT_SERVICE_ACCOUNT=           # per-agent SA email (from `terraform output agent_service_account`)
FACTORY_USE_DLP=0                # 1 = real Cloud DLP de-identify instead of regex
FACTORY_CLOUD_LOGGING=0          # 1 = attach Cloud Logging with agent_id label
FACTORY_TIME_ZONE=America/Denver # Cloud Scheduler timezone
ELIE_DEFAULT_RECIPIENT=ops-owner@davita.example
