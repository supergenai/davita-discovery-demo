+def _validate_gcs(creds: dict) -> ValidationResult:
+    # GCS has no cheap "whoami"; validate the OAuth token via tokeninfo and confirm
+    # it carries a Cloud Storage scope, so a token that can't read objects fails at
+    # connect time rather than on the first tool call.
+    import httpx
+
+    token = creds.get("access_token", "")
+    try:
+        resp = httpx.get(
+            "https://www.googleapis.com/oauth2/v3/tokeninfo",
+            params={"access_token": token},
+            timeout=15,
+        )
+        data = resp.json()
+    except Exception as exc:
+        return ValidationResult(False, error=str(exc))
+    if resp.status_code >= 400 or not isinstance(data, dict):
+        detail = data.get("error_description") if isinstance(data, dict) else None
+        return ValidationResult(
+            False, error=str(detail or "invalid or expired access token")
+        )
+    scope = str(data.get("scope", ""))
+    if "devstorage" not in scope and "cloud-platform" not in scope:
+        return ValidationResult(
+            False,
+            error="token lacks a Cloud Storage scope (need devstorage.read_only or cloud-platform)",
+        )
+    return ValidationResult(True, identity=str(data.get("email") or data.get("azp") or "GCS token"))
+
