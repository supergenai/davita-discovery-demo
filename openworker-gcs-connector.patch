@@ -4621,6 +4621,123 @@ def make_integration_tools(
         )
     )
 
+    # --- Google Cloud Storage ----------------------------------------------
+    _GCS = "https://storage.googleapis.com/storage/v1"
+
+    def gcs_list_buckets(project: str, max_results: int = 20) -> dict[str, Any]:
+        profile, err = _profile(secrets, "gcs", "access_token")
+        if err:
+            return err
+        return _request(
+            "GET",
+            f"{_GCS}/b",
+            headers=_google_headers(profile["access_token"]),
+            params={
+                "project": project,
+                "maxResults": _clamp(max_results, default=20, ceiling=50),
+                "fields": "items(name,location,timeCreated),nextPageToken",
+            },
+        )
+
+    gcs_list_buckets.__name__ = "gcs_list_buckets"
+    tools.append(
+        _attach(
+            gcs_list_buckets,
+            _schema(
+                "gcs_list_buckets",
+                "List Cloud Storage buckets in a GCP project.",
+                {
+                    "project": {"type": "string"},
+                    "max_results": {"type": "integer"},
+                },
+                ["project"],
+            ),
+            caps=["gcs", "read"],
+        )
+    )
+
+    def gcs_list_objects(
+        bucket: str, prefix: str = "", max_results: int = 20
+    ) -> dict[str, Any]:
+        profile, err = _profile(secrets, "gcs", "access_token")
+        if err:
+            return err
+        params: dict[str, Any] = {
+            "maxResults": _clamp(max_results, default=20, ceiling=100),
+            "fields": "items(name,size,updated,contentType),prefixes,nextPageToken",
+        }
+        if prefix:
+            params["prefix"] = prefix
+        return _request(
+            "GET",
+            f"{_GCS}/b/{quote(bucket, safe='')}/o",
+            headers=_google_headers(profile["access_token"]),
+            params=params,
+        )
+
+    gcs_list_objects.__name__ = "gcs_list_objects"
+    tools.append(
+        _attach(
+            gcs_list_objects,
+            _schema(
+                "gcs_list_objects",
+                "List objects in a Cloud Storage bucket, optionally filtered by key prefix.",
+                {
+                    "bucket": {"type": "string"},
+                    "prefix": {"type": "string"},
+                    "max_results": {"type": "integer"},
+                },
+                ["bucket"],
+            ),
+            caps=["gcs", "read"],
+        )
+    )
+
+    def gcs_read_object(
+        bucket: str, object_name: str, max_chars: int = 20000
+    ) -> dict[str, Any]:
+        profile, err = _profile(secrets, "gcs", "access_token")
+        if err:
+            return err
+        headers = _google_headers(profile["access_token"])
+        base = f"{_GCS}/b/{quote(bucket, safe='')}/o/{quote(object_name, safe='')}"
+        meta = _request(
+            "GET", base, headers=headers, params={"fields": "name,size,contentType,updated"}
+        )
+        if not meta.get("ok"):
+            return meta
+        info = meta.get("data") or {}
+        body = _request("GET", base, headers=headers, params={"alt": "media"})
+        if not body.get("ok"):
+            return body
+        text = body.get("data")
+        if not isinstance(text, str):
+            text = json.dumps(text)
+        return {
+            "ok": True,
+            "object": info,
+            "content": text[: max(1, int(max_chars))],
+            "truncated": len(text) > max_chars,
+        }
+
+    gcs_read_object.__name__ = "gcs_read_object"
+    tools.append(
+        _attach(
+            gcs_read_object,
+            _schema(
+                "gcs_read_object",
+                "Read a Cloud Storage object as text (binary blobs return best-effort decoded text).",
+                {
+                    "bucket": {"type": "string"},
+                    "object_name": {"type": "string"},
+                    "max_chars": {"type": "integer"},
+                },
+                ["bucket", "object_name"],
+            ),
+            caps=["gcs", "read"],
+        )
+    )
+
