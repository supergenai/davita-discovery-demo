# Copy to .env and fill in. .env is gitignored — never commit it.
# Generate the token at id.atlassian.com/manage-profile/security/api-tokens

ATLASSIAN_SITE=https://YOURCO.atlassian.net

JIRA_URL=https://YOURCO.atlassian.net
JIRA_USERNAME=you@davita.com
JIRA_API_TOKEN=

CONFLUENCE_URL=https://YOURCO.atlassian.net/wiki
CONFLUENCE_USERNAME=you@davita.com
CONFLUENCE_API_TOKEN=

# Write target for the demo's final step. MUST be a personal/sandbox space.
SANDBOX_SPACE_KEY=

# Model provider key (Anthropic / OpenAI / Google) — non-PHI demo only.
MODEL_API_KEY=
